# All defaults work without credentials. Relative model paths resolve under backend/.
MODEL_PATH=best_subset_model.h5
HOST=127.0.0.1
PORT=5002
MAX_UPLOAD_MB=8
REAL_THRESHOLD=0.5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional text-only guidance. Disabled for the reproducible local demo.
ENABLE_WATSONX=0
IBM_API_KEY=
IBM_REGION=us-south
IBM_PROJECT_ID=
IBM_SPACE_ID=
# Set a currently available model ID in your own Watsonx project.
IBM_MODEL_ID=
